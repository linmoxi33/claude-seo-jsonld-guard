#!/usr/bin/env python3
"""jsonld-guard: offline JSON-LD / schema.org validator that survives @type arrays."""
import argparse
import json
import re
import sys
from pathlib import Path

VERSION = "1.0.0"
BLOCK_RE = re.compile(
    r'<script\b[^>]*type\s*=\s*["\']application/ld\+json["\'][^>]*>(.*?)</script>',
    re.I | re.S,
)

REQUIRED = {
    "Organization": ["name"],
    "Corporation": ["name"],
    "LocalBusiness": ["name", "address"],
    "Person": ["name"],
    "WebSite": ["url"],
    "WebPage": ["url"],
    "Article": ["headline", "author"],
    "NewsArticle": ["headline", "author"],
    "BlogPosting": ["headline", "author"],
    "Product": ["name"],
    "Offer": ["price", "priceCurrency"],
    "Event": ["name", "startDate"],
    "BreadcrumbList": ["itemListElement"],
    "FAQPage": ["mainEntity"],
    "Recipe": ["name", "recipeIngredient"],
    "VideoObject": ["name", "thumbnailUrl", "uploadDate"],
    "Course": ["name", "provider"],
    "ItemList": ["itemListElement"],
    "Service": ["name"],
}


def issue(file, block, path, code, severity, message):
    return {
        "file": file,
        "block": block,
        "path": path,
        "code": code,
        "severity": severity,
        "message": message,
    }


def iter_dicts(obj, path="$"):
    if isinstance(obj, dict):
        yield path, obj
        for key, value in obj.items():
            if key == "@context":
                continue
            yield from iter_dicts(value, f"{path}.{key}")
    elif isinstance(obj, list):
        for index, value in enumerate(obj):
            yield from iter_dicts(value, f"{path}[{index}]")


def validate_document(doc, file, block, issues, ids):
    if isinstance(doc, dict) and "@context" not in doc:
        issues.append(issue(file, block, "$", "missing-context", "warning",
                            "top-level node has no @context"))
    if not isinstance(doc, (dict, list)):
        issues.append(issue(file, block, "$", "invalid-root", "error",
                            "JSON-LD root must be an object or array"))
        return 0

    nodes = 0
    for path, node in iter_dicts(doc):
        if "@type" not in node:
            # Only complain about objects that look like a node, not plain values.
            if set(node) & {"@id", "name", "url", "headline"}:
                issues.append(issue(file, block, path, "missing-type", "error",
                                    "node has no @type"))
            continue
        nodes += 1
        raw = node["@type"]
        if isinstance(raw, str):
            types = [raw]
        elif isinstance(raw, list) and raw and all(isinstance(t, str) for t in raw):
            types = raw
        else:
            issues.append(issue(file, block, path, "invalid-type", "error",
                                "@type must be a string or a non-empty array of strings"))
            continue

        node_id = node.get("@id")
        if isinstance(node_id, str):
            if node_id in ids:
                issues.append(issue(file, block, path, "duplicate-id", "error",
                                    f"duplicate @id {node_id!r}"))
            else:
                ids[node_id] = path

        for type_name in types:
            for prop in REQUIRED.get(type_name, []):
                value = node.get(prop)
                if value is None or value == "" or value == [] or value == {}:
                    issues.append(issue(file, block, path, "missing-required", "error",
                                        f"{type_name} is missing required property {prop!r}"))
    return nodes


def extract(path):
    text = path.read_text(encoding="utf-8", errors="replace")
    if path.suffix.lower() == ".json":
        return [(0, text)]
    return [(i, m.group(1)) for i, m in enumerate(BLOCK_RE.finditer(text), start=1)]


def run(paths):
    files = 0
    blocks = 0
    nodes = 0
    issues = []
    for raw_path in paths:
        path = Path(raw_path)
        if not path.exists():
            raise FileNotFoundError(raw_path)
        targets = [path] if path.is_file() else sorted(
            p for p in path.rglob("*") if p.suffix.lower() in {".html", ".htm", ".json"}
        )
        for target in targets:
            files += 1
            chunks = extract(target)
            if not chunks:
                issues.append(issue(str(target), 0, "$", "no-jsonld", "warning",
                                    "no application/ld+json block found"))
                continue
            ids = {}
            for block_no, raw in chunks:
                blocks += 1
                try:
                    doc = json.loads(raw)
                except json.JSONDecodeError as exc:
                    issues.append(issue(str(target), block_no, "$", "invalid-json", "error",
                                        f"JSON parse error: {exc.msg} at line {exc.lineno}"))
                    continue
                nodes += validate_document(doc, str(target), block_no, issues, ids)
    summary = {
        "files": files,
        "blocks": blocks,
        "nodes": nodes,
        "errors": sum(1 for i in issues if i["severity"] == "error"),
        "warnings": sum(1 for i in issues if i["severity"] == "warning"),
    }
    return issues, summary


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="jsonld-guard",
        description="Validate schema.org JSON-LD in HTML/JSON files offline.",
    )
    parser.add_argument("paths", nargs="+", help="HTML/JSON file or directory")
    parser.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    parser.add_argument("--version", action="version", version=VERSION)
    args = parser.parse_args(argv)

    try:
        issues, summary = run(args.paths)
    except FileNotFoundError as exc:
        print(f"jsonld-guard: no such file or directory: {exc}", file=sys.stderr)
        return 2
    except OSError as exc:
        print(f"jsonld-guard: cannot read input: {exc}", file=sys.stderr)
        return 2

    exit_code = 1 if summary["errors"] else 0

    if args.json:
        payload = {
            "tool": "jsonld-guard",
            "version": VERSION,
            "summary": summary,
            "issues": issues,
        }
        print(json.dumps(payload, indent=2, ensure_ascii=False))
        return exit_code

    for item in issues:
        location = f"{item['file']}:{item['block']}:{item['path']}"
        print(f"{location} {item['severity']} {item['code']}: {item['message']}")
    print(
        "{files} file(s), {blocks} block(s), {nodes} node(s), "
        "{errors} error(s), {warnings} warning(s)".format(**summary)
    )
    return exit_code


if __name__ == "__main__":
    sys.exit(main())
